# Revora AI - Environment Variables Template
# Copy this file to .env or .env.local as needed

# -----------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# -----------------------------------------------------------------------------
# Optional: OpenAI API Key for live GPT-4.1 explanations.
# If omitted or left empty, Revora automatically uses its deterministic fallback reasoning engine.
OPENAI_API_KEY=
